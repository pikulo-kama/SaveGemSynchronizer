
QProgressBar {
    outline: 1px dashed transparent;
    background-color: transparent;
    border: none;
    border-radius: 5px;
    text-align: center;
    font: font("label");
    font-weight: bold;
}

QProgressBar::chunk {
    border-radius: 3px;
}

QProgressPushButton {
    outline: 1px dashed transparent;
    font: font("label");
}

/* Remove icon when progress bar is active. */
QProgressPushButton[in-progress="true"] {
    icon: none;
}


/* Style for primary button */
QProgressPushButton[kind="primary"],
QProgressPushButton[kind="primary"]:pressed,
QProgressPushButton[kind="primary"][is-disabled="true"]:hover,
QProgressBar[kind="QProgressPushButton-primary"]:pressed {
    background-color: color("primary-a30");
    color: color("dark-a0");
}

QProgressBar[kind="QProgressPushButton-primary"] {
    color: color("dark-a0");
}

QProgressPushButton[kind="primary"]:hover,
QProgressBar[kind="QProgressPushButton-primary"]::chunk,
QProgressBar[kind="QProgressPushButton-primary"]::chunk:hover {
    background-color: color("primary-a20");
    color: color("dark-a0");
}


/* Style for secondary button */
QProgressPushButton[kind="secondary"],
QProgressPushButton[kind="secondary"]:pressed,
QProgressPushButton[kind="secondary"][is-disabled="true"]:hover,
QProgressBar[kind="QProgressPushButton-secondary"]:pressed {
    background-color: color("surface-a20");
    color: color("light-a0");
    border: 1px solid color("surface-a40");
}

QProgressBar[kind="QProgressPushButton-secondary"] {
    color: color("light-a0");
}

QProgressPushButton[kind="secondary"]:hover,
QProgressBar[kind="QProgressPushButton-secondary"]::chunk,
QProgressBar[kind="QProgressPushButton-secondary"]::chunk:hover {
    background-color: color("surface-a30");
}

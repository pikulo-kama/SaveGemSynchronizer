
QCustomWidget#saveDetailsCard {
    background-color: color("surface-a20");
    border: 1px solid color("surface-a40");
    border-radius: 5px;
    text-align: left;
}

QCustomWidget#saveDetailsCard QCustomLabel#cardTitle {
    color: rgba("light-a0", 0.4);
    font: font("small-text");
    font-weight: bold;
}

QCustomWidget#saveDetailsCard QCustomLabel#cardContent {
    font: font("body");
}

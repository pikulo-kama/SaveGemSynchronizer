
QCustomWidget#playersContainer QCustomWidget {
    background-color: rgba("surface-a10", 0.7);
    border-radius: 5px;
    border: 1px solid color("surface-a20");
}

QCustomWidget#playersContainer QCustomWidget[id="active"] {
    background: qlineargradient(
        x1:0.2, y1:0, x2:1, y2:0,
        stop:0       color("surface-a10"),
        stop:0.99    color("surface-a10"),
        stop:0.99    color("success-a10"),
        stop:1       color("success-a10")
    );
    border-color: color("success-a0");
}

QCustomWidget#playersContainer QCustomWidget QCustomLabel {
    font: font("accent");
}


QCustomWidget#playersContainer QCustomWidget {
    background-color: rgba("surface-a20", 0.5);
    border-radius: 5px;
    border: 1px solid color("surface-a30");
}

QCustomWidget#playersContainer QCustomWidget[id="active"] {
    background: qlineargradient(
        x1:0.2, y1:0, x2:1, y2:0,
        stop:0       color("surface-a20"),
        stop:0.99    color("surface-a20"),
        stop:0.99    color("success-a20"),
        stop:1       color("success-a20")
    );
    border-color: color("success-a10");
}

QCustomWidget#playersContainer QCustomWidget QCustomLabel {
    font: font("accent");
}

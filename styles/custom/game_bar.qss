
QCustomTabBar#gameBar::tab {
    padding: 10px;
    background-color: transparent;
    font: font("accent");
    border-bottom: 2px solid color("surface-a10");
}

QCustomTabBar#gameBar::tab:!selected {
    color: color("light-a0");
}

QCustomTabBar#gameBar::tab:selected {
    color: color("success-a10");
    border-bottom-color: color("success-a10");
}

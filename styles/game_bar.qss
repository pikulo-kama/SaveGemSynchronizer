
QCustomTabBar#gameBar::tab {
    padding: 10px;
    background-color: transparent;
    font: font("small-text");
    border-bottom: 2px solid transparent;
}

QCustomTabBar#gameBar::tab:!selected {
    color: color("light-a0");
}

QCustomTabBar#gameBar::tab:selected {
    color: color("success-a20");
    border-bottom-color: color("success-a10");
}

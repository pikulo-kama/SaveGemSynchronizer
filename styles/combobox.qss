
QCustomComboBox {
    background-color: rgba("surface-a10", 0.3);
    border: 1px solid color("surface-a40");
    color: color("text-primary");
    outline: 1px solid transparent;
    border-radius: 5px;
    font: font("secondary-xs");
    padding: 5px 10px;
}

QCustomComboBox QAbstractItemView {
    color: color("text-primary");
    background-color: color("surface-a10");
    border: 1px solid color("surface-a40");
    border-radius: 5px;
}

QCustomComboBox::drop-down {
    right: 5px;
    border: none;
}

QCustomComboBox::down-arrow {
    image: image("chevron.svg");
}

QCustomComboBox QAbstractItemView::item {
    padding: 5px;
}

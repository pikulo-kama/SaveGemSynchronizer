
KamaWidget#saveListRecord {
    background-color: rgba("surface-a10", 0.3);
    border: 1px solid color("surface-a20");
    border-radius: 5px;
}

KamaWidget#saveListRecord[active="true"] {
    border-color: color("success-a10");
    background-color: color("surface-a0");
}

KamaLabel#saveListRecordVersion {
    font: font("accent");
    font-weight: bold;
}

KamaLabel#saveListRecordOwner {
    font: font("small");
    color: rgba('text-primary', 0.7);
}

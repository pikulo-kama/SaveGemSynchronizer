
.details-card {
    background-color: color("surface-a10");
    border-radius: 5px;
    text-align: left;

    &--title {
        color: rgba("text-primary", 0.4);
        font: font("small");
        font-weight: bold;
    }

    &--content {
        font: font("card-title");
    }
}

.sync-status-chip {
    background-color: transparent;
    border-radius: 5px;

    & KamaWidget {
        background-color: transparent;
        border-radius: 5px;
    }

    &.visible {
        background-color: color("warning-a20");

        & KamaWidget {
            background-color: color("warning-a0");
        }
    }
}

<KamaSection name="about" label="tr{label_About}" icon="about.svg">
<KamaScrollableWidget layout="vertical" alignment="top-vcenter" spacing="50" ml="20" mt="20" mr="20">

    <!--  Page Header (Logo + description)  -->
    <KamaWidget layout="vertical" alignment="top-vcenter">
        <KamaWidget layout="horizontal" alignment="left">
            <KamaLabel alignment="vcenter">
                pixmap{gem_outline.svg, scale: 50}
            </KamaLabel>
            <KamaLabel alignment="vcenter" class="font-hero">
                prop{application.name}
            </KamaLabel>
        </KamaWidget>
        <KamaLabel class="font-accent">
            tr{label_AppDescription}
        </KamaLabel>
    </KamaWidget>

    <!--  Application Details  -->
    <KamaWidget layout="vertical">
        <KamaLabel class="font-body fg-text-primary-06">
            tr{label_ApplicationDetails}
        </KamaLabel>

        <!--  Version  -->
        <KamaWidget layout="horizontal" alignment="left" spacing="20">
            <KamaLabel class="font-accent fw-bold">
                tr{label_Version}:
            </KamaLabel>
            <KamaLabel class="font-accent">
                prop{application.version}
            </KamaLabel>
        </KamaWidget>

        <!--  Author  -->
        <KamaWidget layout="horizontal" alignment="left" spacing="20">
            <KamaLabel class="font-accent fw-bold">
                tr{label_Author}:
            </KamaLabel>
            <KamaLabel class="font-accent">
                prop{application.author}
            </KamaLabel>
        </KamaWidget>
    </KamaWidget>

    <!--  Contact Us Section  -->
    <KamaWidget layout="vertical">
        <KamaLabel class="font-body fg-text-primary-06">
            tr{label_ContactUs}
        </KamaLabel>

        <!--  GitHub  -->
        <KamaWidget layout="horizontal" alignment="left" spacing="20">
            <KamaLabel class="font-accent fw-bold">
                GitHub:
            </KamaLabel>
            <KamaRichLabel class="font-accent">
                &lt;a href='https://github.com/pikulo-kama/SaveGemSynchronizer'&gt;
                    https://github.com/pikulo-kama/SaveGemSynchronizer&lt;/a&gt;
            </KamaRichLabel>
        </KamaWidget>

        <!--  E-mail  -->
        <KamaWidget layout="horizontal" alignment="left" spacing="20">
            <KamaLabel class="font-accent fw-bold">
                tr{label_Email}:
            </KamaLabel>
            <KamaRichLabel class="font-accent">
                &lt;a href='mailto:jhorr2222@gmail.com'&gt;jhorr2222@gmail.com&lt;/a&gt;
            </KamaRichLabel>
        </KamaWidget>
    </KamaWidget>

    <!--  Copyright & Disclaimer  -->
    <KamaLabel>tr{window_CopyrightDisclaimer, prop{application.name}}</KamaLabel>
    <KamaLabel class="fg-text-primary-07">
        tr{window_Copyright, date{year}, prop{application.name}}
    </KamaLabel>
</KamaScrollableWidget>
</KamaSection>
